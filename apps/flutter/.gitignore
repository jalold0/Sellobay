# Dart / Flutter
.dart_tool/
.packages
build/
*.iml

# pubspec.lock: ILOVALAR uchun commit QILINADI (build takrorlanishi uchun),
# kutubxona/paket uchun yo'q — shuning uchun faqat shared'niki chiqariladi.
shared/pubspec.lock

# Platform artefaktlari (flutter create generatsiya qiladi)
android/.gradle/
android/local.properties
ios/Pods/
ios/.symlinks/
.flutter-plugins
.flutter-plugins-dependencies

# Tarjimalar — GENERATSIYA (pnpm flutter:i18n).
# Commit QILINMAYDI: manba `packages/i18n/src/locales/`, nusxa esa eskirib
# qolsa Flutter jim ravishda eski matnni ko'rsatardi. Flutter loyihasi
# skaffold qilingach CI'ga sinxronlik tekshiruvi qo'shiladi.
shared/assets/i18n/

# Ekran suratlari — `flutter test tool/screens.dart --update-goldens`
# bilan istalgan vaqt qayta chiziladi. Repoda binary saqlashning hojati yo'q.
*/tool/shots/
