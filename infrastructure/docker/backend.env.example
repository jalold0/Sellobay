# NestJS backend (ADR 0012) — lokal Docker sozlamalari.
# Nusxa oling:  cp backend.env.example .env.backend   (`.env.backend` git'ga TUSHMAYDI)
# Har qiymatni o'zingiz yarating; bu yerdagilar FAQAT namuna.
#
# Tasodifiy sir yaratish (Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Postgres ---
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- RabbitMQ ---
RABBITMQ_USER=sellobay
RABBITMQ_PASSWORD=change-me-rabbit

# --- Servislar ---
# Gateway -> servis ichki kaliti (kamida 16 belgi). Faqat gateway biladi.
INTERNAL_API_KEY=change-me-internal-key-16plus

# JWT (HS256), kamida 32 belgi.
#  - LOKAL, izolyatsiyalangan stack uchun istalgan tasodifiy qiymat yaroqli.
#  - Eski Vercel API bilan BIR XIL tokenlar ishlashi kerak bo'lsa (ilovalar kirgan holda
#    qolsin desangiz) — Vercel'dagi JWT_SECRET bilan AYNAN bir xil qiymat qo'yiladi.
JWT_SECRET=change-me-at-least-32-characters-long-secret

# --- Gateway ---
# Hali ko'chirilmagan hamma narsa shu yerga yo'naladi.
LEGACY_URL=https://sellobay-web.vercel.app
# Yoqilgan servislar (vergul bilan). Bo'sh = hammasi eski API'da (xavfsiz boshlang'ich holat).
NEST_ROUTES=
# Brauzer klientlari manzillari (vergul bilan), masalan http://localhost:3000
CORS_ORIGINS=
