# ============================================
# E-Commerce Ekosistema — Environment shabloni
# .env.example dan nusxa olib .env yarating
# ============================================

NODE_ENV=development
TZ=Asia/Tashkent

# --- Asosiy ---
APP_NAME=ecommerce-ecosystem
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_shadow?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ecom:

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PRODUCTS=products

# --- S3 / MinIO (Object Storage) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecom-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- JWT ---
# MAJBURIY. Kamida 32 belgi. Qo'yilmasa yoki qisqa bo'lsa auth ISHLAMAYDI
# (ilova ataylab xato tashlaydi) — ilgari bo'sh kalit bilan jim ishlab,
# istalgan odam admin tokenini yasashi mumkin edi.
# Yaratish: openssl rand -base64 48
JWT_SECRET=change-me-in-production-with-strong-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
# Eslatma: refresh token JWT EMAS — u tasodifiy opaque satr bo'lib, bazada
# SHA-256 hash sifatida saqlanadi (qarang apps/*/src/lib/auth/session.ts).
# Shu sababli JWT_REFRESH_SECRET/JWT_REFRESH_EXPIRES_IN ishlatilmaydi.

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- SMS (Eskiz / Playmobile) ---
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# --- Email (SMTP / SendGrid) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="E-Commerce <noreply@example.uz>"

# --- O'zbekiston to'lov tizimlari ---
# Merchant kassa ochilgach to'ldiring (Vercel env'ga ham qo'shing). Bo'sh bo'lsa
# onlayn to'lov o'chirilgan hisoblanadi, naqd (COD) ishlaydi.
# Click: redirect (service_id/merchant_id) + webhook imzosi (secret_key).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=   # faqat Click Merchant API (refund/cancel) uchun

# Payme: redirect (merchant_id) + Merchant API auth kaliti (PAYME_KEY).
# DIQQAT: kod PAYME_KEY nomini o'qiydi (payme webhook Basic auth: "Paycom:<PAYME_KEY>").
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ENDPOINT=https://checkout.paycom.uz

UZUM_BANK_MERCHANT_ID=
UZUM_BANK_SECRET=

# Qo'lda karta o'tkazmasi (Payme/Click merchant hisobisiz ishlaydigan oqim).
# JSON massiv. QO'YILMASA production'da karta to'lovi checkout'da UMUMAN
# TAKLIF QILINMAYDI (ilgari mijozga soxta "SELLOBAY TEST" kartasi ko'rsatilardi).
MANUAL_PAYMENT_CARDS='[{"number":"8600 1234 5678 9012","holder":"SELLOBAY MCHJ","bank":"Uzcard"}]'

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_URL=

# --- Instagram / Meta ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=

# --- Fayl saqlash (Vercel Blob) ---
# Mahsulot rasmlari (ochiq) va to'lov cheklari (yopiq) shu do'konda saqlanadi.
#
# Vercel'da do'kon loyihaga ulanganda BLOB_STORE_ID avtomatik qo'yiladi va
# kalitning o'zi env'ga umuman tushmaydi — SDK ishlash paytida OIDC token
# oladi. Lokalda ishlash uchun `vercel env pull` qiling.
#
# BLOB_READ_WRITE_TOKEN faqat Vercel'dan TASHQARIDA (masalan boshqa CI'da)
# ishlaganda kerak bo'ladi.
#
# Ikkalasi ham yo'q bo'lsa rasm yuklash 503 qaytaradi (jim ishlamaydi).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- Observability ---
# Source map yuklash uchun (build vaqtida). Bo'lmasa prod xatolari
# minifikatsiyalangan, o'qib bo'lmas stack bo'lib qoladi.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=debug

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Frontend (Next.js public) ---
# MAJBURIY (prod). Sitemap, robots.txt, canonical URL, OG rasm va
# structured data shundan quriladi. Qo'yilmasa hammasi
# http://localhost:3000 bo'lib qoladi va Google shuni indekslaydi.
NEXT_PUBLIC_SITE_URL=https://sellobay.uz

# Ilova yuklab olish havolalari (/download sahifasidagi tugmalar).
# Bo'sh bo'lsa mos tugma ko'rsatilmaydi.
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_TESTFLIGHT_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=uz
NEXT_PUBLIC_SUPPORTED_LOCALES=uz,ru,en
NEXT_PUBLIC_DEFAULT_CURRENCY=UZS
NEXT_PUBLIC_TELEGRAM_BOT=
NEXT_PUBLIC_SENTRY_DSN=

# --- Mobile (Expo) ---
# API bazasi apps/mobile/app.json -> expo.extra.apiBaseUrl da sozlanadi
# (production: https://sellobay-web.vercel.app). Bu yerda env kerak emas.
EXPO_PUBLIC_APP_NAME=Sellobay

# --- Qo'llab-quvvatlash (GET /api/config dagi `support`) ---
# Berilmagan kanal ilovada KO'RSATILMAYDI — to'qima raqam yoki
# bo'sh tugma chiqmasligi uchun.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Foydalanuvchi nomi yoki to'liq havola: `sellobay_support` yoki
# `https://t.me/sellobay_support`.
SUPPORT_TELEGRAM=

# --- Rate limiting (ixtiyoriy — bo'lmasa in-memory fallback ishlaydi) ---
# Upstash Redis REST (https://upstash.com — bepul tier yetarli).
# Berilsa login/OTP/orders limitlari barcha serverless instanslar orasida umumiy bo'ladi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ish jarayoni ilovasi (apps/roadmap) — ichki kirish paroli.
# DIQQAT: bu ildizda emas, apps/roadmap/.env.local ga qoyiladi.
ROADMAP_PASSWORD=""

# --- Sotuvchi moderatsiyasi ---
# `true` bo'lsa sotuvchi yaratgan mahsulot admin tasdig'ini KUTMAYDI va darhol
# ACTIVE bo'ladi (e2e testlar uchun). Dev'da (NODE_ENV != production) baribir
# avto-tasdiq ishlaydi. PRODUCTION'da bo'sh qoldiring.
SELLER_PRODUCT_AUTOAPPROVE=
